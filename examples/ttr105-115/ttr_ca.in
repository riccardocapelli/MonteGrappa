# TTR(105-115) protofilament (PDB 2M5N, model 1): structure-based CA model
# whose native contacts, also between chains, are shared by all chains (go_homo)
pdbfile         protofilament.pdb
backbone_atoms  1 CA
nosidechain
atomtypes       go_homo
imin            4               # minimum separation along a chain for native contacts
potential       go
r_hardcore      4.0
r_native        7.5             # includes the facing strand of the other sheet (zipper)
go-energy       -1.0
go_dihedrals
e_dih1          1.0
e_dih3          0.5
debug           1
polfile         ttr_ca.pol
potfile         ttr_ca.pot
